rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /family_photos/{allPaths=**} {
      // Herkes aile fotoğraflarını görüntüleyebilir
      allow read: if true;
      // 10MB altındaki resimler yüklenebilir
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
